<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- デフォルト設定読み込み -->
    <!-- <include resource="org/springframework/boot/logging/logback/base.xml" /> -->
    <!-- <include resource="org/springframework/boot/logging/logback/defaults.xml" /> -->
    <!-- <include resource="org/springframework/boot/logging/logback/console-appender.xml" /> -->


    <property name="logFileName" value="app" />
    <!-- パターンを外部定義 -->
    <!-- <property name="PATTERN_STDOUT" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n"/> -->
    <property name="PATTERN_STDOUT" value="%green(%d{yyyy-MM-dd HH:mm:ss}) [%thread] %X{requestId} %highlight(%-5level) %logger:%-3L - %msg%n"/>
    <property name="PATTERN_STDOUT_MDC" value="%green(%d{yyyy-MM-dd HH:mm:ss}) [%thread] %X{requestId} %highlight(%-5level) %logger:%-3L - %msg%X%n"/>



    <!--ローカル環境用設定 -->
    <springProfile name="default">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.out</target>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${PATTERN_STDOUT}</pattern>
            </encoder>
        </appender>
        <appender name="STDOUT_FW" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.out</target>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${PATTERN_STDOUT_MDC}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!--develop環境用設定 -->
    <springProfile name="dev">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.out</target>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${PATTERN_STDOUT}</pattern>
            </encoder>
        </appender>

        <appender name="STDOUT_FW" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.out</target>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${PATTERN_STDOUT_MDC}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!--production環境用設定 -->
    <springProfile name="production">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- <includeMdc>false</includeMdc> MDCを無視 -->
            </encoder>
        </appender>

        <appender name="STDOUT_FW" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            </encoder>
        </appender>
    </springProfile>

    <!-- <logger name="nu" level="DEBUG" />
    <logger name="org" level="INFO" /> -->
    
    <!--FWのLogger-->
    <logger name="nu.mine.kino.advice" additivity="false">
        <appender-ref ref="STDOUT_FW"/>
    </logger>
    <logger name="nu.mine.kino.filter" additivity="false">
        <appender-ref ref="STDOUT_FW"/>
    </logger>
    <logger name="nu.mine.kino.interceptor" additivity="false">
        <appender-ref ref="STDOUT_FW"/>
    </logger>

    <!--その他のLogger-->
    <root>
      <appender-ref ref="STDOUT" />
    </root>
</configuration>